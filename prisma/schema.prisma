datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  CUSTOMER
}

// ملاحظة: القيم بحروف صغيرة عمدًا لتبقى متوافقة مع الكود الحالي ('processing' | 'delivered' | 'cancelled')
enum OrderStatus {
  processing
  shipped
  delivered
  cancelled
}

enum CouponType {
  PERCENTAGE // خصم نسبي (value = 10 يعني 10%)
  FIXED      // خصم ثابت (value = مبلغ بالعملة)
}

// ─────────────────────── Users & Auth ───────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  birthday      DateTime? // لخصم عيد الميلاد
  role          Role      @default(CUSTOMER)
  points        Int       @default(0)
  tier          String    @default("العضوية البرونزية")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  wishlist  Wishlist[]
  cart      Cart?
  reviews   Review[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// مطلوب من Auth.js للتحقق من البريد وروابط "نسيت كلمة المرور"
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────── Catalog: Categories & Products ───────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String?  @unique
  note           String?                 // وصف قصير (مثل: علبة هدايا ١ كجم)
  description    String?  @db.Text       // الوصف الكامل لصفحة المنتج
  category       String?                 // قديم: يُحتفظ به للتوافق، استخدم categoryId للجديد
  categoryId     String?
  badge          String?                 // مثل: الأكثر مبيعاً، جديد
  price          Float
  compareAtPrice Float?                  // السعر قبل الخصم (للشطب)
  image          String                  // الصورة الرئيسية
  sku            String?  @unique
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  ratingAvg      Float    @default(0)    // قيمة مخزنة تُحدَّث عند تغيّر المراجعات
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  occasions OccasionProduct[]

  productCategory Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  wishlists       Wishlist[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, categoryId, price])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ─────────────────────── Wishlist ───────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ─────────────────────── Cart ───────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique // سلة واحدة لكل مستخدم
  couponId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([couponId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

// ─────────────────────── Addresses ───────────────────────

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String   // المنزل، العمل...
  recipientName String?
  city          String
  district      String?
  street        String
  postalCode    String?
  country       String   @default("SA")
  phone         String
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
}

// ─────────────────────── Orders ───────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement()) // للعرض مثل SD-10482
  userId          String
  total           Float       // الإجمالي النهائي = subtotal - discount + shippingFee
  subtotal        Float       @default(0)
  discount        Float       @default(0)
  shippingFee     Float       @default(0)
  status          OrderStatus @default(processing)
  couponId        String?
  couponCode      String?     // نسخة وقت الشراء
  addressId       String?
  shippingAddress Json?       // نسخة من العنوان وقت الشراء (تبقى حتى لو حُذف العنوان)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
  @@index([addressId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?  // يصبح null لو حُذف المنتج، والسجل يبقى بفضل name/price
  name      String   // نسخة وقت الشراء
  image     String?
  qty       Int
  price     Float    // سعر الوحدة وقت الشراء

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ─────────────────────── Reviews ───────────────────────

model Review {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  rating             Int      // 1-5 (القيد في migration يدوي، انظر الشرح)
  title              String?
  comment            String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true) // للإشراف على المراجعات
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // مراجعة واحدة لكل مستخدم على المنتج
  @@index([productId, isApproved, createdAt])
}

// ─────────────────────── Coupons ───────────────────────

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique // خزّنه بحروف كبيرة دائمًا
  description    String?
  type           CouponType
  value          Float
  minOrderAmount Float?
  maxDiscount    Float?     // سقف الخصم للكوبونات النسبية
  usageLimit     Int?       // إجمالي مرات الاستخدام (null = غير محدود)
  perUserLimit   Int?       // مرات الاستخدام لكل مستخدم
  usedCount      Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  orders Order[]
  carts  Cart[]

  @@index([isActive, expiresAt])
}
model Occasion {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String?                // سطر قصير تحت الاسم
  description String?   @db.Text
  image       String                 // صورة المناسبة (بلاطة + غلاف الباقة)
  startsAt    DateTime?              // اختياري: بداية الظهور (مواسم مثل رمضان)
  endsAt      DateTime?              // اختياري: نهاية الظهور
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  products OccasionProduct[]

  @@index([isActive, sortOrder])
}

// جدول وسيط: منتجات المناسبة، مع كمية كل منتج داخل "الباقة"
model OccasionProduct {
  occasionId String
  productId  String
  qty        Int    @default(1)
  sortOrder  Int    @default(0)

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([occasionId, productId])
  @@index([productId])
}